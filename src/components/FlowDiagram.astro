---
// Diagrama de flujo del hero: disparadores -> agente IA -> acciones.
// Los textos son <text> reales (indexables y accesibles), no una imagen.

type Node = { id: string; side: 'l' | 'r'; y: number; title: string; sub: string; icon: string };

const W = 190;
const H = 48;
const LX = 20;
const RX = 750;

const nodes: Node[] = [
	{ id: 'wa', side: 'l', y: 40, title: 'Chatbot WhatsApp', sub: 'Mensajes de clientes', icon: 'i-chat' },
	{ id: 'sw', side: 'l', y: 113, title: 'Agente de voz', sub: 'Llamadas entrantes', icon: 'i-mic' },
	{ id: 'au', side: 'l', y: 230, title: 'Integraciones', sub: 'Flujos internos', icon: 'i-switch' },
	{ id: 'sh', side: 'r', y: 40, title: 'Cliente atendido', sub: 'Respuesta al instante', icon: 'i-send' },
	{ id: 'se', side: 'r', y: 113, title: 'Citas', sub: 'Agendado automático', icon: 'i-cal' },
	{ id: 'ca', side: 'r', y: 230, title: 'Panel personalizado', sub: 'Controla tu empresa', icon: 'i-dash' },
];

// Puntos de conexión: [nodo, x del agente, y del agente]
const links: [string, number, number][] = [
	['wa', 380, 48],
	['sw', 380, 137],
	['au', 380, 156],
	['sh', 580, 48],
	['se', 580, 137],
	['ca', 580, 156],
];

const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const paths = links.map(([id, ax, ay], i) => {
	const n = byId[id];
	const nx = n.side === 'l' ? LX + W : RX;
	const ny = n.y + H / 2;
	const [x1, y1, x2, y2] = n.side === 'l' ? [nx, ny, ax, ay] : [ax, ay, nx, ny];
	const xm = (x1 + x2) / 2;
	return { id: `p${i}`, d: `M${x1} ${y1} C${xm} ${y1} ${xm} ${y2} ${x2} ${y2}` };
});

// Versión móvil: solo iconos
const mIcons = [
	{ y: 14, icon: 'i-chat', side: 'l' },
	{ y: 66, icon: 'i-mic', side: 'l' },
	{ y: 118, icon: 'i-switch', side: 'l' },
	{ y: 14, icon: 'i-send', side: 'r' },
	{ y: 66, icon: 'i-cal', side: 'r' },
	{ y: 118, icon: 'i-dash', side: 'r' },
];
const mPaths = mIcons.map((m, i) => {
	const x1 = m.side === 'l' ? 58 : 242;
	const x2 = m.side === 'l' ? 112 : 188;
	const y1 = m.y + 22;
	const y2 = 50 + (i % 3) * 24;
	const [a, b, c, d] = m.side === 'l' ? [x1, y1, x2, y2] : [x2, y2, x1, y1];
	const xm = (a + c) / 2;
	return { id: `m${i}`, d: `M${a} ${b} C${xm} ${b} ${xm} ${d} ${c} ${d}` };
});
---

<div class="flow w-full" data-flow>
	<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
		<defs>
			<symbol id="i-chat" viewBox="0 0 24 24"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></symbol>
			<symbol id="i-mic" viewBox="0 0 24 24"
				><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" /><path
					d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"></path></symbol
			>
			<symbol id="i-sheet" viewBox="0 0 24 24"
				><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h8M10 9H8"
				></path></symbol
			>
			<symbol id="i-send" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4ZM22 2 11 13" /></symbol>
			<symbol id="i-cal" viewBox="0 0 24 24"
				><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"
				></path></symbol
			>
			<symbol id="i-switch" viewBox="0 0 24 24"
				><path d="M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 9a9 9 0 0 1-9 9"
				></path></symbol
			>
			<symbol id="i-dash" viewBox="0 0 24 24"
				><path d="M3 3h7v9H3zM14 3h7v5h-7zM14 12h7v9h-7zM3 16h7v5H3z"></path></symbol
			>
			<symbol id="i-bot" viewBox="0 0 24 24"
				><path d="M12 8V4H8M4 8h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zM2 14h2M20 14h2M15 13v2M9 13v2"
				></path></symbol
			>
			<linearGradient id="agentGlow" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#ff4d0d" stop-opacity=".9"></stop>
				<stop offset="1" stop-color="#ff4d0d" stop-opacity="0"></stop>
			</linearGradient>
		</defs>
	</svg>

	<!-- Escritorio / tablet -->
	<svg
		class="hidden h-auto w-full md:block"
		viewBox="0 0 960 330"
		role="img"
		aria-label="Esquema: mensajes de WhatsApp, llamadas e integraciones llegan a un agente de IA que deja al cliente atendido, agenda citas y alimenta un panel personalizado"
	>

		<g fill="none" stroke-linecap="round">
			{paths.map((p) => <path id={p.id} d={p.d} class="flow-line" />)}
			<path d="M480 74 V104" class="flow-line" />
			<path d="M480 170 V300" stroke="url(#agentGlow)" stroke-width="2"></path>
			<path d="M474 292 L480 304 L486 292" stroke="#ff4d0d" stroke-width="2"></path>
		</g>

		{paths.map((p) => (
			<circle r="3.5" fill="#ff6a30" class="flow-dot">
				<animateMotion dur="3.4s" repeatCount="indefinite" begin={`${(Number(p.id.slice(1)) * 0.55).toFixed(2)}s`}>
					<mpath href={`#${p.id}`} />
				</animateMotion>
			</circle>
		))}

		<!-- Agentes -->
		<g>
			<rect x="380" y="22" width="200" height="52" rx="10" class="node" />
			<use href="#i-bot" x="396" y="36" width="24" height="24" class="icon" />
			<text x="432" y="55" class="agent-title">AGENTE IA</text>

			<rect x="380" y="104" width="200" height="66" rx="10" class="node node-hot" />
			<use href="#i-bot" x="396" y="116" width="24" height="24" class="icon icon-hot" />
			<text x="432" y="133" class="node-title">Agente IA</text>
			<text x="432" y="152" class="node-sub">Memoria y herramientas</text>
		</g>

		<!-- Nodos laterales -->
		{nodes.map((n) => {
			const x = n.side === 'l' ? LX : RX;
			return (
				<g>
					<rect x={x} y={n.y} width={W} height={H} rx="10" class="node" />
					<rect x={x + 10} y={n.y + 9} width="30" height="30" rx="8" class="icon-box" />
					<use href={`#${n.icon}`} x={x + 15} y={n.y + 14} width="20" height="20" class="icon" />
					<text x={x + 50} y={n.y + 22} class="node-title">{n.title}</text>
					<text x={x + 50} y={n.y + 38} class="node-sub">{n.sub}</text>
				</g>
			);
		})}
	</svg>

	<!-- Móvil: versión simplificada solo con iconos -->
	<svg
		class="mx-auto block h-auto w-full max-w-sm md:hidden"
		viewBox="0 0 300 170"
		role="img"
		aria-label="Esquema: mensajes de WhatsApp, llamadas e integraciones llegan a un agente de IA que deja al cliente atendido, agenda citas y alimenta un panel personalizado"
	>
		<g fill="none" stroke-linecap="round">
			{mPaths.map((p) => <path id={p.id} d={p.d} class="flow-line" />)}
		</g>
		{mPaths.map((p) => (
			<circle r="3" fill="#ff6a30" class="flow-dot">
				<animateMotion dur="3s" repeatCount="indefinite" begin={`${(Number(p.id.slice(1)) * 0.5).toFixed(2)}s`}>
					<mpath href={`#${p.id}`} />
				</animateMotion>
			</circle>
		))}
		<rect x="112" y="34" width="76" height="80" rx="12" class="node node-hot" />
		<use href="#i-bot" x="138" y="52" width="24" height="24" class="icon icon-hot" />
		<text x="150" y="98" text-anchor="middle" class="agent-title" style="font-size:12px">AGENTE IA</text>
		{mIcons.map((m) => {
			const x = m.side === 'l' ? 14 : 242;
			return (
				<g>
					<rect x={x} y={m.y} width="44" height="44" rx="12" class="node" />
					<use href={`#${m.icon}`} x={x + 11} y={m.y + 11} width="22" height="22" class="icon" />
				</g>
			);
		})}
	</svg>
</div>

<style is:global>
	.flow .node {
		fill: rgba(16, 17, 20, 0.85);
		stroke: rgba(255, 255, 255, 0.14);
		stroke-width: 1;
	}
	.flow .node-hot {
		stroke: rgba(255, 106, 48, 0.55);
		filter: drop-shadow(0 0 14px rgba(255, 77, 13, 0.35));
	}
	.flow .icon-box {
		fill: rgba(255, 255, 255, 0.07);
	}
	.flow .icon {
		fill: none;
		stroke: #e4e4e7;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
		color: #e4e4e7;
	}
	.flow .icon-hot {
		stroke: #ff8a4c;
	}
	.flow .node-title {
		fill: #f4f4f5;
		font-size: 13px;
		font-weight: 500;
	}
	.flow .node-sub {
		fill: #9a9aa3;
		font-size: 10.5px;
	}
	.flow .agent-title {
		fill: #d4d4d8;
		font-size: 20px;
		letter-spacing: 0.04em;
	}
	.flow .flow-line {
		stroke: rgba(255, 138, 76, 0.55);
		stroke-width: 1.4;
		stroke-dasharray: 5 7;
		animation: flow-dash 1.6s linear infinite;
	}
	@keyframes flow-dash {
		to {
			stroke-dashoffset: -24;
		}
	}
</style>

<script>
	// SMIL no respeta prefers-reduced-motion por CSS: se pausa aquí.
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<SVGSVGElement>('[data-flow] svg').forEach((svg) => {
			svg.pauseAnimations();
			svg.querySelectorAll('.flow-dot').forEach((d) => d.setAttribute('visibility', 'hidden'));
		});
	}
</script>
